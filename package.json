{
  "name": "musicplayer",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n SERVER,CLIENT -c yellow,cyan \"npm:server:dev\" \"npm:client:dev\"",
    "server:dev": "npm run dev --workspace=server",
    "client:dev": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client",
    "start": "node server/index.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
