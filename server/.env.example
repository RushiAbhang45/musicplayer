YOUTUBE_API_KEY=
PORT=5000
CATEGORY_CACHE_TTL_HOURS=12
SEARCH_CACHE_TTL_MINUTES=60

# Region for the homepage "Trending" chart (YouTube mostPopular, 1 quota
# unit) and how often it refreshes.
TRENDING_REGION=IN
TRENDING_CACHE_TTL_HOURS=6

# Optional: restrict CORS to your deployed frontend once you have its URL,
# e.g. https://your-site.netlify.app (comma-separate for more than one).
# Leave unset to allow all origins (fine for local dev).
CLIENT_ORIGIN=

# Optional: accounts (sign up/log in, playlists that sync across devices).
# Leave both unset to run guest-only, exactly like the app worked before -
# no login UI is shown and every /api/{auth,playlists,recent} route returns
# 503. See README "Accounts (optional)" for how to get a free Postgres
# connection string (Neon or Supabase) and generate a JWT secret.
DATABASE_URL=
JWT_SECRET=
