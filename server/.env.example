YOUTUBE_API_KEY=
PORT=5000
CATEGORY_CACHE_TTL_HOURS=12
SEARCH_CACHE_TTL_MINUTES=60

# Optional: restrict CORS to your deployed frontend once you have its URL,
# e.g. https://your-site.netlify.app (comma-separate for more than one).
